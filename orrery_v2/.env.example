# Standalone orrery_v2/docker-compose.yml deployment inputs.
# Orrery and the optional identity overlay both read this file.
ORRERY_API_BIND=127.0.0.1
ORRERY_API_PORT=8080
ORRERY_V2_ROOT=.
ORRERY_APP_PUBLIC_URL=https://orrery.example.com
ORY_KRATOS_PUBLIC_URL=https://login.orrery.example.com/
ORY_HYDRA_PUBLIC_URL=https://auth.orrery.example.com/
ORY_KRATOS_POSTGRES_USER=kratos
ORY_KRATOS_POSTGRES_PASSWORD=__SET_IN_SECRET_STORE__
ORY_KRATOS_POSTGRES_DB=kratos
ORY_KRATOS_COOKIE_SECRET=__SET_IN_SECRET_STORE__
ORY_KRATOS_CIPHER_SECRET=__SET_IN_SECRET_STORE__
ORY_HYDRA_SYSTEM_SECRET=__SET_IN_SECRET_STORE__
ORY_HYDRA_POSTGRES_USER=hydra
ORY_HYDRA_POSTGRES_PASSWORD=__SET_IN_SECRET_STORE__
ORY_HYDRA_POSTGRES_DB=hydra
OPENFGA_POSTGRES_USER=openfga
OPENFGA_POSTGRES_PASSWORD=__SET_IN_SECRET_STORE__
OPENFGA_POSTGRES_DB=openfga
ORY_HYDRA_PUBLIC_BIND=127.0.0.1
ORY_HYDRA_PUBLIC_PORT=4444
ORY_KRATOS_PUBLIC_BIND=127.0.0.1
ORY_KRATOS_PUBLIC_PORT=4433
OPENFGA_HTTP_BIND=127.0.0.1
OPENFGA_HTTP_PORT=8081
ORRERY_POSTGRES_PASSWORD=__SET_IN_SECRET_STORE__
ORRERY_BOOTSTRAP_SUPERADMIN_PASSWORD=__SET_IN_SECRET_STORE__
ORRERY_SECRET_KNOWLEDGE_PAGEINDEX=__SET_IN_SECRET_STORE__
ORRERY_SECRET_ONTOLOGY_CURSOR_KEY_V1=__SET_IN_SECRET_STORE__
ORRERY_SECRET_ONTOLOGY_CURSOR_KEY_V0=__SET_IN_SECRET_STORE__
ORRERY_GATEWAY_SECRET_KEY=__SET_IN_SECRET_STORE__
ORRERY_GATEWAY_SECRET_KEY_FILE=/var/lib/orrery/secrets/gateway-config-key
ORRERY_RUNTIME_MCP_TOKEN=__SET_IN_SECRET_STORE__
ORRERY_RUNTIME_MCP_AUTHORIZATION=__SET_IN_SECRET_STORE__
ORRERY_INTERNAL_VIEWER_TOKEN=__SET_IN_SECRET_STORE__
ORRERY_INTERNAL_VIEWER_AUTHORIZATION=__SET_IN_SECRET_STORE__
ORRERY_AUTH_LOCAL_MFA_TOTP_SECRET=__SET_IN_SECRET_STORE__
ORRERY_FEISHU_APP_ID=
ORRERY_FEISHU_APP_SECRET=__SET_IN_SECRET_STORE__
ORRERY_FEISHU_STATE_SECRET=__SET_IN_SECRET_STORE__
ORRERY_KRATOS_ADMIN_TOKEN=__SET_IN_SECRET_STORE__
ORRERY_OIDC_CLIENT_SECRET=__SET_IN_SECRET_STORE__
ORRERY_HYDRA_ADMIN_TOKEN=__SET_IN_SECRET_STORE__
ORRERY_AUTHZ_OPENFGA_TOKEN=__SET_IN_SECRET_STORE__
# Optional restricted server browser; configure both values together. Pin the MCP binary (currently chrome-devtools-mcp 1.7.0) and use a loopback HTTP CDP URL.
ORRERY_SERVER_BROWSER_MCP_COMMAND=
ORRERY_SERVER_BROWSER_CDP_URL=
# Optional comma-separated agent profile IDs in addition to the configured discussion agent.
ORRERY_SERVER_BROWSER_AGENT_IDS=
