{
  "tabs": {
    "type": "object",
    "additionalProperties": false,
    "required": [],
    "properties": {}
  },
  "snapshot": {
    "type": "object",
    "additionalProperties": false,
    "required": ["tabId"],
    "properties": {
      "tabId": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    }
  },
  "screenshot": {
    "type": "object",
    "additionalProperties": false,
    "required": ["tabId"],
    "properties": {
      "tabId": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    }
  },
  "navigate": {
    "type": "object",
    "additionalProperties": false,
    "required": ["tabId", "url", "operationId"],
    "properties": {
      "tabId": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "url": {
        "type": "string",
        "maxLength": 8192
      },
      "operationId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{8,100}$"
      }
    }
  },
  "click": {
    "type": "object",
    "additionalProperties": false,
    "required": ["tabId", "snapshotId", "ref", "operationId"],
    "properties": {
      "tabId": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "snapshotId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{8,100}$"
      },
      "ref": {
        "type": "string",
        "pattern": "^e[1-9][0-9]{0,5}$"
      },
      "operationId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{8,100}$"
      }
    }
  },
  "fill": {
    "type": "object",
    "additionalProperties": false,
    "required": ["tabId", "snapshotId", "ref", "text", "operationId"],
    "properties": {
      "tabId": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "snapshotId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{8,100}$"
      },
      "ref": {
        "type": "string",
        "pattern": "^e[1-9][0-9]{0,5}$"
      },
      "text": {
        "type": "string",
        "maxLength": 10000
      },
      "operationId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{8,100}$"
      }
    }
  },
  "press": {
    "type": "object",
    "additionalProperties": false,
    "required": ["tabId", "snapshotId", "ref", "key", "operationId"],
    "properties": {
      "tabId": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "snapshotId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{8,100}$"
      },
      "ref": {
        "type": "string",
        "pattern": "^e[1-9][0-9]{0,5}$"
      },
      "key": {
        "type": "string",
        "enum": ["Enter", "Escape", "Tab", "ArrowUp", "ArrowDown", "ArrowLeft", "ArrowRight", "Space"]
      },
      "operationId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{8,100}$"
      }
    }
  },
  "select": {
    "type": "object",
    "additionalProperties": false,
    "required": ["tabId", "snapshotId", "ref", "value", "operationId"],
    "properties": {
      "tabId": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "snapshotId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{8,100}$"
      },
      "ref": {
        "type": "string",
        "pattern": "^e[1-9][0-9]{0,5}$"
      },
      "value": {
        "type": "string",
        "maxLength": 10000
      },
      "operationId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{8,100}$"
      }
    }
  },
  "scroll": {
    "type": "object",
    "additionalProperties": false,
    "required": ["tabId", "direction", "pixels", "operationId"],
    "properties": {
      "tabId": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "direction": {
        "type": "string",
        "enum": ["up", "down", "left", "right"]
      },
      "pixels": {
        "type": "integer",
        "minimum": 1,
        "maximum": 2000
      },
      "operationId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{8,100}$"
      }
    }
  },
  "approval_status": {
    "type": "object",
    "additionalProperties": false,
    "required": ["approvalId"],
    "properties": {
      "approvalId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{8,100}$"
      }
    }
  }
}
