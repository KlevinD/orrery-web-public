# Immutable release references are generated by CI for each release.
ORRERY_API_IMAGE=registry.example.com/orrery/api@sha256:replace
ORRERY_WEB_IMAGE=registry.example.com/orrery/web@sha256:replace
PAGEINDEX_IMAGE=registry.example.com/orrery/pageindex@sha256:replace
ORY_KRATOS_IMAGE=oryd/kratos@sha256:replace
ORY_HYDRA_IMAGE=oryd/hydra@sha256:replace
OPENFGA_IMAGE=openfga/openfga@sha256:replace
