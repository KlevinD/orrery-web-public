*.sh text eol=lf
# Shared protocol fixtures are compared byte-for-byte on every platform.
orrery-desktop/tests/fixtures/orrery-device-v1/*.json text eol=lf
orrery_v2/internal/agent/runtime/providers/device/testdata/orrery-device-v1/*.json text eol=lf
orrery_v2/internal/device/browser/operations.schema.json text eol=lf

# Preserve npm tarball license bytes referenced by integrity evidence.
compliance/licenses/*.txt -text whitespace=cr-at-eol
# Collected upstream notices are immutable evidence, including their whitespace.
compliance/licenses/collected/*.txt -text -whitespace
