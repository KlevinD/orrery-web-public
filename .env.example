# Deployment topology. API runtime values are in
# orrery_v2/config/orrery.production.yaml; build defaults are in
# orrery_v2/config/build.env.
ORRERY_WEB_BIND=127.0.0.1
ORRERY_WEB_PORT=27381
ORRERY_API_BIND=127.0.0.1
ORRERY_API_PORT=8080
ORRERY_POSTGRES_BIND=127.0.0.1
ORRERY_POSTGRES_PORT=5434
PAGEINDEX_BIND=127.0.0.1
PAGEINDEX_PORT=8091
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILE=3

# Release selection. Replace local.env with a generated digest manifest in production.
ORRERY_RELEASE_FILE=orrery_v2/deploy/releases/local.env

# Optional PageIndex overlay; none of its variables is required by the default stack.
# External image implementing the Orrery PageIndex service contract.
# PAGEINDEX_IMAGE is selected by the release manifest; override it explicitly if needed.

# Shared identity stack configuration. Orrery API and Kratos consume the same
# Feishu registration from this file; do not duplicate it in the YAML profile.
ORRERY_V2_ROOT=./orrery_v2
ORRERY_APP_PUBLIC_URL=https://orrery.example.com
ORY_KRATOS_PUBLIC_URL=https://login.orrery.example.com/
ORY_HYDRA_PUBLIC_URL=https://auth.orrery.example.com/
ORY_KRATOS_POSTGRES_USER=kratos
ORY_KRATOS_POSTGRES_PASSWORD=__SET_IN_SECRET_STORE__
ORY_KRATOS_POSTGRES_DB=kratos
ORY_KRATOS_COOKIE_SECRET=__SET_IN_SECRET_STORE__
ORY_KRATOS_CIPHER_SECRET=__SET_IN_SECRET_STORE__
ORY_HYDRA_SYSTEM_SECRET=__SET_IN_SECRET_STORE__
ORY_HYDRA_POSTGRES_USER=hydra
ORY_HYDRA_POSTGRES_PASSWORD=__SET_IN_SECRET_STORE__
ORY_HYDRA_POSTGRES_DB=hydra
OPENFGA_POSTGRES_USER=openfga
OPENFGA_POSTGRES_PASSWORD=__SET_IN_SECRET_STORE__
OPENFGA_POSTGRES_DB=openfga
ORY_HYDRA_PUBLIC_BIND=127.0.0.1
ORY_HYDRA_PUBLIC_PORT=4444
ORY_KRATOS_PUBLIC_BIND=127.0.0.1
ORY_KRATOS_PUBLIC_PORT=4433
OPENFGA_HTTP_BIND=127.0.0.1
OPENFGA_HTTP_PORT=8081

# Orrery PostgreSQL secret; PageIndex database values below are only for the optional overlay.
ORRERY_POSTGRES_PASSWORD=__SET_IN_SECRET_STORE__
PAGEINDEX_POSTGRES_USER=pageindex
PAGEINDEX_POSTGRES_PASSWORD=__SET_IN_SECRET_STORE__
PAGEINDEX_POSTGRES_DB=pageindex_service
PAGEINDEX_POSTGRES_HOST=orrery-postgres
PAGEINDEX_POSTGRES_SERVICE_PORT=5432

# Orrery bootstrap and runtime secrets.
ORRERY_BOOTSTRAP_SUPERADMIN_PASSWORD=__SET_IN_SECRET_STORE__
ORRERY_SECRET_ONTOLOGY_CURSOR_KEY_V1=__SET_IN_SECRET_STORE__
ORRERY_SECRET_ONTOLOGY_CURSOR_KEY_V0=__SET_IN_SECRET_STORE__
ORRERY_GATEWAY_SECRET_KEY=__SET_IN_SECRET_STORE__
ORRERY_GATEWAY_SECRET_KEY_FILE=/var/lib/orrery/secrets/gateway-config-key
ORRERY_RUNTIME_MCP_TOKEN=__SET_IN_SECRET_STORE__
ORRERY_RUNTIME_MCP_AUTHORIZATION=__SET_IN_SECRET_STORE__
ORRERY_INTERNAL_VIEWER_TOKEN=__SET_IN_SECRET_STORE__
ORRERY_INTERNAL_VIEWER_AUTHORIZATION=__SET_IN_SECRET_STORE__
ORRERY_AUTH_LOCAL_MFA_TOTP_SECRET=__SET_IN_SECRET_STORE__
ORRERY_FEISHU_APP_ID=
ORRERY_FEISHU_APP_SECRET=__SET_IN_SECRET_STORE__
ORRERY_FEISHU_STATE_SECRET=__SET_IN_SECRET_STORE__
ORRERY_KRATOS_ADMIN_TOKEN=__SET_IN_SECRET_STORE__
ORRERY_OIDC_CLIENT_SECRET=__SET_IN_SECRET_STORE__
ORRERY_HYDRA_ADMIN_TOKEN=__SET_IN_SECRET_STORE__
ORRERY_AUTHZ_OPENFGA_TOKEN=__SET_IN_SECRET_STORE__

# PageIndex owns its own runtime configuration and secrets.
PAGEINDEX_API_KEY=__SET_IN_SECRET_STORE__
PAGEINDEX_API_KEY_PREVIOUS=__SET_IN_SECRET_STORE__
PAGEINDEX_OAUTH_DYNAMIC_REGISTRATION_ENABLED=false
PAGEINDEX_OAUTH_REGISTRATION_TOKEN=__SET_IN_SECRET_STORE__
PAGEINDEX_LLM_API_KEY=__SET_IN_SECRET_STORE__
PAGEINDEX_LLM_API_BASE=
PAGEINDEX_MODEL=
PAGEINDEX_RETRIEVE_MODEL=
PAGEINDEX_LOG_LEVEL=INFO
PAGEINDEX_INIT_DB=1
PAGEINDEX_DB_WAIT_SECONDS=60
PAGEINDEX_MAX_UPLOAD_BYTES=52428800
PAGEINDEX_MAX_XLSX_CELLS=100000
PAGEINDEX_SCANNED_PDF_MIN_TEXT_CHARS=80
PAGEINDEX_SCANNED_PDF_MIN_IMAGES=1
PAGEINDEX_WORKERS=2
